# Copy this file to .env for local runs. .env is in .gitignore — never commit real keys.
HINDSIGHT_API_KEY=
GROQ_API_KEY=
# Sarvam: Indian-language voice in (Saaras), voice out (Bulbul), translation, backup brain (Sarvam-105B)
SARVAM_API_KEY=
# Optional
SEED_TOKEN=pick-any-long-random-text
HINDSIGHT_BANK_PREFIX=ustaad
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: auto-save live data to a branch of your repo (fine-grained token, this repo only, Contents: Read and write)
GITHUB_TOKEN=
GITHUB_REPO=
